# Copie para .env e ajuste conforme seu ambiente. Nunca commitar .env real.
#
# Em desenvolvimento local sem Docker/Postgres instalado, `npm run db:start`
# sobe um PostgreSQL real embutido (scripts/dev-db.mjs) nesta mesma URL.
# Em qualquer outro ambiente (Docker, Postgres gerenciado, staging, produção),
# aponte para o serviço real — nenhum código do projeto muda.
DATABASE_URL="postgresql://estuda:estuda_dev_local_only@127.0.0.1:55432/estuda_dev"

# Origem pública real do app (sem barra no final) — usada SÓ para montar o
# link de redefinição de senha (etapa de fechamento, seção 10). Nunca lida
# de cabeçalhos da requisição (Host/X-Forwarded-Host são controláveis pelo
# cliente e serviriam para forjar o link enviado por e-mail) — sempre este
# valor fixo, configurado pelo operador do ambiente. Em produção, DEVE ser a
# URL HTTPS real (ex.: "https://app.estuda.com.br").
APP_BASE_URL="http://localhost:3000"
