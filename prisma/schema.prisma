// ============================================================================
// SCHEMA v3 — Plataforma de Aprendizagem + Enciclopédia Acadêmica de Psicologia
// Documento de arquitetura — NÃO aplicado ainda (sem migration executada).
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// NOTA — validado com Prisma CLI 7.9.1 (`npx prisma validate`) em 2026-08-18:
// na major 7 do Prisma, `url` deixou de ser aceita dentro do bloco datasource
// do schema.prisma; a conexão passa a ser configurada em `prisma.config.ts`
// (adapter para Client, migrate.adapter/url para Migrate). A sintaxe exata
// desse arquivo fica para o Módulo 1 (depende da doc oficial da versão
// instalada no momento do scaffold) — não fixada aqui para não arriscar
// documentar uma API que pode mudar até lá.
datasource db {
  provider = "postgresql"
}

